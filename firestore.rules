rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Koleksi Produk Kurma
    match /kurma_items/{itemId} {
      allow read, write: if true;
    }

    // Koleksi Catatan Perusahaan (Rekening & Ekspedisi)
    match /company_notes/{noteId} {
      allow read, write: if true;
    }

    // Koleksi Tahun Database
    match /database_years/{yearId} {
      allow read, write: if true;
    }

    // Pengaturan Aplikasi Global (Judul, Marquee, dll)
    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    // Riwayat Aktivitas CRUD Realtime
    match /crud_logs/{logId} {
      allow read, write: if true;
    }
  }
}
